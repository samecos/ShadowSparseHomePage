{
  "name": "hermes-homepage-api-mcp",
  "version": "3.0.0",
  "description": "让机器人知道个人主页 HTTP API 和 MCP Server 如何发现、鉴权、调用与容错。",
  "entry": "agent/SKILL.md",
  "identity": "agent/HERMES.md",
  "owner": "疏影渡",
  "env": {
    "HOMEPAGE_BASE_URL": {
      "required": true,
      "description": "主页地址，结尾不要带斜杠",
      "example": "http://localhost:3000"
    },
    "HERMES_API_TOKEN": {
      "required": true,
      "description": "写操作 Bearer Token",
      "example": "local-hermes"
    }
  },
  "discovery": {
    "health": "GET /api/health",
    "manifest": "GET /api/agent/manifest",
    "digest": "GET /api/agent/digest",
    "rule": "先读 /api/agent/manifest；manifest 与本文件冲突时以 manifest 为准。"
  },
  "auth": {
    "type": "bearer",
    "header": "Authorization: Bearer <HERMES_API_TOKEN>",
    "publicReads": true,
    "notes": [
      "不要把 Token 写入 URL 或输出给用户",
      "机器人不需要管理员 Cookie"
    ]
  },
  "http": {
    "baseUrlEnv": "HOMEPAGE_BASE_URL",
    "responseEnvelope": {
      "success": { "ok": true, "data": "any" },
      "error": { "ok": false, "error": "string", "details": "optional any" }
    },
    "endpoints": [
      { "method": "GET", "path": "/api/health", "auth": false, "description": "检查站点可用性与内容统计" },
      { "method": "GET", "path": "/api/agent/manifest", "auth": false, "description": "读取完整端点、schemas 与 MCP 工具清单" },
      { "method": "GET", "path": "/api/agent/digest", "auth": false, "description": "读取收件箱统计与最近待整理内容" },
      { "method": "GET", "path": "/api/collectibles", "auth": false, "query": ["status", "type", "tag", "q", "limit", "offset"], "description": "检索收藏" },
      { "method": "POST", "path": "/api/agent/collect", "auth": true, "description": "单条或批量收藏，支持按 URL 去重" },
      { "method": "POST", "path": "/api/agent/collect/batch", "auth": true, "description": "批量收藏，最多 50 条" },
      { "method": "PATCH", "path": "/api/collectibles/:id", "auth": true, "description": "更新收藏" },
      { "method": "DELETE", "path": "/api/collectibles/:id", "auth": true, "description": "删除收藏" },
      { "method": "POST", "path": "/api/upload", "auth": true, "contentType": "multipart/form-data", "field": "file", "description": "上传图片或 PDF" },
      { "method": "GET", "path": "/api/posts", "auth": false, "query": ["mood", "limit"], "description": "读取日常说说" },
      { "method": "POST", "path": "/api/posts", "auth": true, "description": "发布说说" },
      { "method": "PATCH", "path": "/api/posts/:id", "auth": true, "description": "修改说说" },
      { "method": "DELETE", "path": "/api/posts/:id", "auth": true, "description": "删除说说" },
      { "method": "GET", "path": "/api/map-stories", "auth": false, "query": ["q", "tag"], "description": "读取地图故事" },
      { "method": "POST", "path": "/api/map-stories", "auth": true, "description": "创建地图故事" },
      { "method": "PATCH", "path": "/api/map-stories/:id", "auth": true, "description": "修改标注或移动照片坐标" },
      { "method": "DELETE", "path": "/api/map-stories/:id", "auth": true, "description": "删除地图故事" },
      { "method": "GET", "path": "/api/trips", "auth": false, "query": ["status", "q"], "description": "读取旅行；Bearer Token 可读取准备中和进行中的私密旅行" },
      { "method": "POST", "path": "/api/trips", "auth": true, "description": "创建一条默认私密的旅行计划" },
      { "method": "GET", "path": "/api/trips/:id", "auth": false, "description": "读取一条旅行；私密内容需要管理员会话或 Bearer Token" },
      { "method": "PATCH", "path": "/api/trips/:id", "auth": true, "description": "更新旅行状态、行程、清单、预订记录、现场记录或回顾草稿；进行中状态强制私密" },
      { "method": "DELETE", "path": "/api/trips/:id", "auth": true, "description": "删除一条旅行及其私有附件" },
      { "method": "GET", "path": "/api/trips/:id/attachments", "auth": false, "description": "读取旅行附件元数据；私有附件需要鉴权" },
      { "method": "POST", "path": "/api/trips/:id/attachments", "auth": true, "contentType": "multipart/form-data", "description": "上传旅行媒体或私有预订附件，单文件不超过 8MB" },
      { "method": "GET", "path": "/api/trips/:id/attachments/:attachmentId", "auth": false, "description": "读取附件；公开旅行只允许读取媒体附件，预订附件永不公开" },
      { "method": "GET", "path": "/api/works", "auth": false, "description": "读取工作展示数据" }
    ]
  },
  "mcp": {
    "server": "mcp/hermes-server.mjs",
    "transport": "stdio",
    "command": "node",
    "args": ["/absolute/path/to/HomePage/mcp/hermes-server.mjs"],
    "env": {
      "HOMEPAGE_BASE_URL": "http://localhost:3000",
      "HERMES_API_TOKEN": "your-hermes-token"
    },
    "hostConfig": {
      "mcpServers": {
        "homepage": {
          "command": "node",
          "args": ["/absolute/path/to/HomePage/mcp/hermes-server.mjs"],
          "env": {
            "HOMEPAGE_BASE_URL": "http://localhost:3000",
            "HERMES_API_TOKEN": "your-hermes-token"
          }
        }
      }
    },
    "lifecycle": ["initialize", "notifications/initialized", "tools/list", "tools/call"],
    "tools": [
      {
        "name": "collect_item",
        "description": "收藏一条链接、图像、句子、声音或文件，默认进入 inbox",
        "http": "POST /api/agent/collect",
        "inputSchema": {
          "type": "object",
          "required": ["title", "type"],
          "properties": {
            "title": { "type": "string" },
            "type": { "type": "string", "enum": ["link", "image", "quote", "moment", "file"] },
            "url": { "type": "string" },
            "image": { "type": "string" },
            "quote": { "type": "string" },
            "description": { "type": "string" },
            "agentSummary": { "type": "string" },
            "tags": { "type": "array", "items": { "type": "string" } },
            "source": { "type": "string" },
            "status": { "type": "string", "enum": ["inbox", "curated", "archived"] },
            "collectedBy": { "type": "string", "enum": ["me", "hermes", "unknown"] }
          }
        },
        "returns": ["created", "existed", "invalid"]
      },
      {
        "name": "collect_batch",
        "description": "批量收藏 1-50 条内容，自动 URL 去重",
        "http": "POST /api/agent/collect/batch",
        "inputSchema": {
          "type": "object",
          "required": ["items"],
          "properties": {
            "items": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "object" } }
          }
        },
        "returns": ["created", "existed", "invalid"]
      },
      {
        "name": "list_collections",
        "description": "按状态、类型、标签、关键词检索收藏",
        "http": "GET /api/collectibles",
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["inbox", "curated", "archived"] },
            "type": { "type": "string", "enum": ["link", "image", "quote", "moment", "file"] },
            "tag": { "type": "string" },
            "query": { "type": "string" },
            "limit": { "type": "number" }
          }
        },
        "returns": ["items", "total"]
      },
      {
        "name": "update_collection",
        "description": "更新收藏标题、标签、摘要、状态或精选标记",
        "http": "PATCH /api/collectibles/:id",
        "inputSchema": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": { "type": "string" },
            "title": { "type": "string" },
            "description": { "type": "string" },
            "agentSummary": { "type": "string" },
            "tags": { "type": "array", "items": { "type": "string" } },
            "status": { "type": "string", "enum": ["inbox", "curated", "archived"] },
            "featured": { "type": "boolean" }
          }
        },
        "returns": ["collectible"]
      },
      {
        "name": "archive_collection",
        "description": "归档一条收藏，保留数据但不再公开显示",
        "http": "PATCH /api/collectibles/:id",
        "inputSchema": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" } } },
        "returns": ["collectible"]
      },
      {
        "name": "create_post",
        "description": "以站长身份发布日常说说",
        "http": "POST /api/posts",
        "inputSchema": {
          "type": "object",
          "required": ["content"],
          "properties": {
            "content": { "type": "string" },
            "mood": { "type": "string" },
            "location": { "type": "string" },
            "images": { "type": "array", "items": { "type": "string" } }
          }
        },
        "returns": ["post"]
      },
      {
        "name": "list_map_stories",
        "description": "读取地图故事，可按关键词或标签筛选",
        "http": "GET /api/map-stories",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": { "type": "string" },
            "tag": { "type": "string" }
          }
        },
        "returns": ["items", "total"]
      },
      {
        "name": "annotate_map_story",
        "description": "修改地图故事的标题、文字标注、日期或地点",
        "http": "PATCH /api/map-stories/:id",
        "inputSchema": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": { "type": "string" },
            "title": { "type": "string" },
            "note": { "type": "string" },
            "date": { "type": "string" },
            "locationName": { "type": "string" },
            "tags": { "type": "array", "items": { "type": "string" } }
          }
        },
        "returns": ["mapStory"]
      },
      {
        "name": "move_map_photo",
        "description": "移动地图上某张照片的精确坐标",
        "http": "PATCH /api/map-stories/:id",
        "inputSchema": {
          "type": "object",
          "required": ["storyId", "photoId", "lat", "lng"],
          "properties": {
            "storyId": { "type": "string" },
            "photoId": { "type": "string" },
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "returns": ["mapStory"]
      },
      {
        "name": "upload_media",
        "description": "上传 MCP 所在机器上的本地图片或 PDF，返回公开 URL",
        "http": "POST /api/upload",
        "inputSchema": {
          "type": "object",
          "required": ["filePath"],
          "properties": { "filePath": { "type": "string" } }
        },
        "returns": ["url"]
      },
      {
        "name": "daily_digest",
        "description": "读取收件箱统计和最近待整理内容",
        "http": "GET /api/agent/digest",
        "inputSchema": { "type": "object", "properties": {} },
        "returns": ["statusCount", "typeCount", "topTags", "inbox", "instruction"]
      },
      {
        "name": "list_trips",
        "description": "读取旅行；Bearer Token 可读取私密计划",
        "http": "GET /api/trips",
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["planning", "active", "completed", "archived"] },
            "query": { "type": "string" }
          }
        },
        "returns": ["items", "total"]
      },
      {
        "name": "get_trip",
        "description": "读取一条旅行的完整计划、清单、预订记录和沿途记录",
        "http": "GET /api/trips/:id",
        "inputSchema": {
          "type": "object",
          "required": ["id"],
          "properties": { "id": { "type": "string" } }
        },
        "returns": ["trip", "attachments"]
      },
      {
        "name": "create_trip",
        "description": "创建一条默认私密的旅行计划",
        "http": "POST /api/trips",
        "inputSchema": {
          "type": "object",
          "required": ["title", "startDate", "endDate"],
          "properties": {
            "title": { "type": "string" },
            "summary": { "type": "string" },
            "destinations": { "type": "array", "items": { "type": "string" } },
            "startDate": { "type": "string" },
            "endDate": { "type": "string" },
            "tags": { "type": "array", "items": { "type": "string" } },
            "days": { "type": "array", "items": { "type": "object" } },
            "reservations": { "type": "array", "items": { "type": "object" } }
          }
        },
        "returns": ["trip"]
      },
      {
        "name": "update_trip",
        "description": "更新旅行计划、清单、预订、记录或回顾草稿",
        "http": "PATCH /api/trips/:id",
        "inputSchema": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": { "type": "string" },
            "title": { "type": "string" },
            "summary": { "type": "string" },
            "coverAttachmentId": { "type": "string" },
            "destinations": { "type": "array", "items": { "type": "string" } },
            "startDate": { "type": "string" },
            "endDate": { "type": "string" },
            "tags": { "type": "array", "items": { "type": "string" } },
            "status": { "type": "string", "enum": ["planning", "active", "completed", "archived"] },
            "visibility": { "type": "string", "enum": ["private", "public"] },
            "days": { "type": "array", "items": { "type": "object" } },
            "reservations": { "type": "array", "items": { "type": "object" } },
            "entries": { "type": "array", "items": { "type": "object" } },
            "recap": { "type": "object" }
          }
        },
        "returns": ["trip"]
      },
      {
        "name": "delete_trip",
        "description": "删除旅行及其私有附件，调用前必须确认目标",
        "http": "DELETE /api/trips/:id",
        "inputSchema": {
          "type": "object",
          "required": ["id"],
          "properties": { "id": { "type": "string" } }
        },
        "returns": ["deleted", "id"]
      },
      {
        "name": "upload_trip_attachment",
        "description": "上传旅行图片或私有预订文件",
        "http": "POST /api/trips/:id/attachments",
        "inputSchema": {
          "type": "object",
          "required": ["tripId", "filePath"],
          "properties": {
            "tripId": { "type": "string" },
            "filePath": { "type": "string" },
            "kind": { "type": "string", "enum": ["media", "reservation"] },
            "reservationId": { "type": "string" }
          }
        },
        "returns": ["id", "originalName", "kind", "downloadUrl"]
      }
    ]
  },
  "defaults": {
    "status": "inbox",
    "collectedBy": "hermes",
    "dedupeByUrl": true,
    "maxUploadBytes": 8388608
  },
  "workflows": {
    "capture": ["upload_media?", "collect_item"],
    "curate": ["daily_digest", "list_collections", "update_collection"],
    "publish": ["daily_digest", "create_post"],
    "mapAnnotation": ["list_map_stories", "annotate_map_story", "move_map_photo?"],
    "travelPlan": ["list_trips", "create_trip?", "get_trip", "update_trip", "upload_trip_attachment?"],
    "travelPublish": ["get_trip", "update_trip"]
  },
  "errors": {
    "400": "字段校验失败，按 error 修正参数",
    "401": "Token 错误，停止重试并检查 HERMES_API_TOKEN",
    "404": "id 不存在，重新查询列表",
    "413": "文件超过 8MB",
    "415": "文件类型不支持",
    "500": "最多指数退避重试 3 次"
  },
  "guards": [
    "只能通过 API 或 MCP 操作，不直接修改 data/*.json",
    "删除或公开发布前先向用户确认",
    "不重复创建相同 URL 的收藏",
    "不把 Token、私有路径或私人内容输出给用户",
    "旅行计划和预订附件默认私密，active 旅行永远不能公开",
    "预订附件只能通过旅行附件接口上传，不使用普通公开媒体 URL",
    "不确定时先读 /api/agent/manifest"
  ]
}
