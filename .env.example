# 站点的对外地址（部署后改成真实域名）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MCP Server 默认读取的站点地址
HOMEPAGE_BASE_URL=http://localhost:3000

# 后台写操作口令：通过隐藏的后台入口登录后使用
HOMEPAGE_ADMIN_TOKEN=change-me-admin-token

# 隐藏的后台入口地址（仅路径，不含斜杠）。请设置成只有你知道的随机字符串，至少 8 位。
# 生成本地地址：node -e "console.log(require('crypto').randomBytes(8).toString('hex'))"
HOMEPAGE_ADMIN_SLUG=replace-with-a-long-random-string

# 会话签名密钥；不填时会回退使用 HOMEPAGE_ADMIN_TOKEN
HOMEPAGE_SESSION_SECRET=change-me-session-secret

# HERMES / 其他个人 AGENT 的 Bearer Token
HERMES_API_TOKEN=change-me-hermes-token

# MapTiler Cloud 地图底图（https://cloud.maptiler.com/account/keys/）
# KEY 仅由服务端瓦片代理读取，不会暴露到浏览器。
MAPTILER_KEY=replace-with-your-maptiler-key

# MapTiler Key 的 “Allowed User-Agent header” 限制项。
# 填入与 MapTiler 控制台完全一致（区分大小写）的 User-Agent 子串。
# 浏览器不允许 JavaScript 自定义 User-Agent，所以瓦片由服务端代理携带该值请求。
MAPTILER_USER_AGENT=personal-homepage-maptiler/1.0

# 可选：覆盖默认的 MapTiler 样式 ID（默认已按下列值配置）
# MAPTILER_SATELLITE_MAP_ID=satellite-v4
# MAPTILER_BASE_MAP_ID=base-v4

# 可选：默认底图，satellite 为鸟瞰卫星影像，base 为浅色 Base 地图
# NEXT_PUBLIC_MAP_DEFAULT_LAYER=satellite
